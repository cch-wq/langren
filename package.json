{
  "name": "werewolf-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n VITE,WRANGLER -c blue,green \"vite\" \"wrangler pages dev dist --port 8788 --d1=DB\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "wrangler d1 execute werewolf-game --local --file=d1-schema.sql",
    "db:init:remote": "wrangler d1 execute werewolf-game --remote --file=d1-schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^9.0.0",
    "vite": "^5.1.6",
    "wrangler": "^3.78.0"
  }
}
